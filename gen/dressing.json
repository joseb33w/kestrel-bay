   "npc": {
    "id": "harbour_master",
    "name": "Alwyn Rees",
    "model": "/cloud-q7026dnarajiwk7glrcg/models/meshy/harbour_master.glb",
    "gender": "male",
    "age": "elder",
    "persona": "Alwyn Rees, harbour master of Kestrel Bay, 61, Welsh-Cornish, gruff, dry humour, thirty years at sea before he took the office on the quay. Knows every boat and tide. Suspicious about lights seen on the old wreck of the trawler Marguerite down the coast at night - he thinks smugglers are using her and the sea caves. Speaks plainly in one or two short salty sentences. No fantasy language; this is a real rainy fishing town.",
    "lines": [
     "Alwyn: You'll be the one asking about the wreck. Sit down before you drip on my charts.",
     "Alwyn: The Marguerite went aground two winters back. Nobody salvaged her - but somebody's using her.",
     "Alwyn: Take the boat out if you must. Mind the caves past the wreck. Those aren't fishermen."
    ],
    "activity": "idle",
    "pos": [
     4.578,
     -6.864
    ]
